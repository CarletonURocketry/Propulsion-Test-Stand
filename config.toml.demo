[server]
addr = '127.0.0.1'
port = 65431

[relay]
#Valve = 'Board.Number'
XV1 = 'A.1'
XV2 = 'A.2'
XV3 = 'A.3'
XV4 = 'A.4'
XV5 = 'B.1'
XV6 = 'B.2'

[switch]
XV1 = 'A.1'
XV2 = 'A.2'
XV3 = 'A.3'
XV4 = 'A.4'
XV5 = 'B.1'
XV6 = 'B.2'


[data]
format = {time = ["elapsedTime", "currentTime"], pressures = ["pi1","pi2"], temps = ["t1","t2"], valves = ["XV1", "XV2", "XV3", "XV4", "XV5", "XV6"], loads = ["L1", "dm"]}

[log]
path = "Logs/"
name = "testLog" # Appends current date and time to the name